# OpenAI / OpenAI-Compatible Model Credentials
# If left unset or with placeholder, TalentGraph Agent automatically runs in deterministic mock mode.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Agent Settings
TEMPERATURE=0.0
MAX_TOOL_ITERATIONS=6
